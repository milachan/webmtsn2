# ===== Database (MySQL / MariaDB) =====
# Format: mysql://username:password@host:port/database_name
# Untuk Laragon (default): mysql://root:@localhost:3306/nama_database
DATABASE_URL="mysql://root:@localhost:3306/mtsn2_kebumen"

# ===== Deployment =====
# Untuk hosting/production, ganti sesuai kredensial dari penyedia hosting Anda.
# Contoh:
# DATABASE_URL="mysql://user:password@host:3306/mtsn2_kebumen"

# ===== Integrasi Berita (Portal Web Berita) =====
# Origin (base URL) proyek web berita. Halaman "Berita & Kegiatan Terbaru" di web utama
# membaca berita dari API publik web berita (GET /api/berita) melalui route /api/berita-publik.
# Local dev: jalankan web berita di port 3001 (web utama memakai 3000).
# Produksi: ganti dengan domain subdomain web berita, contoh:
# BERITA_API_URL="https://berita.mtsnegeri2kebumen.sch.id"
BERITA_API_URL="http://localhost:3001"

# ===== Tautan Publik ke Portal Berita =====
# Dipakai untuk membangun link "Baca Selengkapnya" / "Lihat Semua Berita" / menu Berita
# yang mengarah ke portal web berita (klien, di-inline saat build).
NEXT_PUBLIC_BERITA_URL="https://berita.mtsnegeri2kebumen.sch.id"
